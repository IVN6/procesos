{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "backlog-mind-pwa",
  "name": "Backlog Mind — Servidores de Memoria",
  "short_name": "BacklogMind",
  "description": "Sistema de liberación de RAM mental y gestión de foco sin fricción.",
  "start_url": "./log.html",
  "scope": "./",
  "display": "standalone",
